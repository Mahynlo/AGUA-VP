{
  "name": "aguavp",
  "version": "1.2.900",
  "description": "Sistema de gestion de Agua Potable",
  "main": "./out/main/index.js",
  "author": "AguaVP-MHNL",
  "homepage": "https://github.com/Mahynlo/AGUA-VP",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "release:new": "node scripts/version-tag.cjs release:new",
    "release:push": "node scripts/version-tag.cjs release:push",
    "prerelease:new": "node scripts/version-tag.cjs prerelease:new",
    "prerelease:push": "node scripts/version-tag.cjs prerelease:push",
    "version:new": "node scripts/version-tag.cjs version:new",
    "version:push": "node scripts/version-tag.cjs version:push",
    "latest:tag": "node scripts/version-tag.cjs latest:tag",
    "latest:release": "node scripts/version-tag.cjs latest:release",
    "postinstall": "electron-rebuild -o better-sqlite3",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
